# KaliVibeCoding Website — Environment Variables
# Copy to .env.local and fill in real values
# NEVER commit .env.local

# ─── Public (safe to expose in browser) ───────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.kalivibecoding.com
NEXT_PUBLIC_API_URL=https://kalivibecoding-api.kalivibecoding.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://xxx@o0.ingest.sentry.io/xxx

# ─── Server Only ──────────────────────────────────────────────────────────────
# These are set via `wrangler secret put` for the Worker, not .env.local

# Cloudflare Email Workers token (YOUR_EMAIL_TOKEN)
# wrangler secret put KVC_EMAIL_TOKEN

# GoHighLevel webhook URL
# wrangler secret put GHL_WEBHOOK_URL

# Sentry DSN (server-side Worker)
# wrangler secret put SENTRY_DSN
